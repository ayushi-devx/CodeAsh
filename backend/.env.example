PORT=5000
MONGODB_URI=mongodb://localhost:27017/codeash
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# AWS Judge0 Configuration (PRODUCTION - RECOMMENDED)
# Judge0 running on AWS EC2 Ubuntu Server at 100.53.209.86:2358
# Supports 22+ programming languages with full isolation and security
JUDGE0_URL=http://54.87.1.93:2358

# Fallback disabled - Using only AWS Judge0 server
ENABLE_FALLBACK_EXECUTOR=false

# Alternative: RapidAPI Judge0 (if AWS server unavailable)
# JUDGE0_API_KEY=your_judge0_api_key
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com


# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
